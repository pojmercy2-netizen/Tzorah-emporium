# ─── TZORAH EMPORIUM — Required Environment Variables ───────────────────────
# Copy this file to .env and fill in your values.
# On Netlify, set these in: Site Settings → Environment Variables

# PostgreSQL / Neon connection string (REQUIRED)
# Neon format:  postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# JWT secret key – use a long random string in production
SECRET_KEY=your-super-secret-jwt-key-change-me

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base URL of the deployed site (used for image URLs, links, etc.)
BASE_URL=https://your-netlify-site.netlify.app

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_CALLBACK_URL=https://your-netlify-site.netlify.app/payment/verify
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret
